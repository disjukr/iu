{
  "name": "iu-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter iu build && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "check": "pnpm --filter iu build && pnpm -r check",
    "test": "pnpm build && pnpm -r test",
    "test:package": "pnpm --filter iu build && pnpm --filter iu exec node --test tests/package.test.mjs",
    "preview": "pnpm --filter @iu/docs preview"
  }
}
